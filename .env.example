# Risk Factor Comparison App - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env should NEVER be committed to version control

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=your_secure_secret_key_here_generated_by_security_setup_py

# Database Configuration
# Example: postgresql://username:password@localhost:5432/risk_factor_db
DATABASE_URL=

# Optional: Add other sensitive configuration here
# OPENAI_API_KEY=
# DEBUG=False

# A generated test user api key for authenticating to the API endpoints.
# This is for testing purposes only and should not be used in production.
# TEST_API_KEY=your_test_api_key_here